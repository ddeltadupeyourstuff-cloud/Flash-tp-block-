-- Scrapz flash tp block (Fast Blue UI + Rename)

print("Loading Scrapz flash tp block (Fast Blue)...")

-- Load the hub instantly
loadstring(game:HttpGet("https://raw.githubusercontent.com/dadas45845/limitedhublph/refs/heads/main/FlashAndBlock"))()

wait(0.3)  -- Much faster loading

-- Quick rename + blue color change
local found = false
local blueColor = Color3.fromRGB(0, 110, 255)
local darkBlue = Color3.fromRGB(0, 55, 160)
local lightBlue = Color3.fromRGB(80, 170, 255)

-- Fast scan in CoreGui
for _, gui in ipairs(game:GetService("CoreGui"):GetDescendants()) do
    if gui:IsA("ScreenGui") then
        for _, child in ipairs(gui:GetDescendants()) do
            -- Rename title
            if (child:IsA("TextLabel") or child:IsA("TextButton")) and child.Text then
                if child.Text:find("LIMITED HUB") or child.Text:upper():find("LIMITED") then
                    child.Text = "Scrapz flash tp block"
                    found = true
                end
            end
            
            -- Apply blue colors
            if child:IsA("Frame") or child:IsA("TextButton") or child:IsA("TextLabel") then
                if child.BackgroundColor3 then
                    local brightness = child.BackgroundColor3.R + child.BackgroundColor3.G + child.BackgroundColor3.B
                    if brightness < 0.7 then
                        child.BackgroundColor3 = darkBlue
                    elseif brightness > 1.3 then
                        child.BackgroundColor3 = lightBlue
                    else
                        child.BackgroundColor3 = blueColor
                    end
                end
                if child:IsA("TextLabel") or child:IsA("TextButton") then
                    child.TextColor3 = Color3.new(1, 1, 1)
                end
            end
        end
    end
end

-- Quick backup in PlayerGui
local pg = game.Players.LocalPlayer:FindFirstChild("PlayerGui")
if pg then
    for _, gui in ipairs(pg:GetDescendants()) do
        if gui:IsA("ScreenGui") then
            for _, child in ipairs(gui:GetDescendants()) do
                if (child:IsA("TextLabel") or child:IsA("TextButton")) and child.Text then
                    if child.Text:find("LIMITED HUB") or child.Text:upper():find("LIMITED") then
                        child.Text = "Scrapz flash tp block"
                        found = true
                    end
                end
                
                if child:IsA("Frame") or child:IsA("TextButton") or child:IsA("TextLabel") then
                    if child.BackgroundColor3 then
                        local brightness = child.BackgroundColor3.R + child.BackgroundColor3.G + child.BackgroundColor3.B
                        if brightness < 0.7 then
                            child.BackgroundColor3 = darkBlue
                        elseif brightness > 1.3 then
                            child.BackgroundColor3 = lightBlue
                        else
                            child.BackgroundColor3 = blueColor
                        end
                    end
                    if child:IsA("TextLabel") or child:IsA("TextButton") then
                        child.TextColor3 = Color3.new(1, 1, 1)
                    end
                end
            end
        end
    end
end

if found then
    print("✅ Scrapz flash tp block (Fast Blue) loaded!")
else
    print("⚠️ Loaded but rename/color may need re-run if GUI is slow.")
end
